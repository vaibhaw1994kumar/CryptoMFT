{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/credential-audit-1.0.0.json",
  "title": "Credential access and change audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "ts_ns", "action", "outcome",
    "credential_id", "actor", "venue", "environment", "version",
    "permissions", "reason", "secret_backend", "secret_material_logged",
    "previous_hash", "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "format": "uuid"},
    "ts_ns": {"type": "integer", "minimum": 0},
    "action": {"enum": ["REGISTER", "INJECT", "ROTATE", "REVOKE"]},
    "outcome": {"enum": ["SUCCEEDED", "DENIED", "FAILED"]},
    "credential_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "venue": {"type": "string"},
    "environment": {"type": "string"},
    "version": {"type": "integer", "minimum": 0},
    "permissions": {
      "type": "array",
      "items": {"enum": ["READ_MARKET", "READ_ACCOUNT", "TRADE", "CANCEL"]}
    },
    "reason": {"type": "string"},
    "secret_backend": {"type": "string", "minLength": 1},
    "secret_material_logged": {"const": false},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
