{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/alert-ownership-1.0.0.json",
  "title": "Paper pipeline alert ownership matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coverage_statement", "policies"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "coverage_statement": {"type": "string", "minLength": 1},
    "policies": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alert_type", "owner", "severity", "response_target_minutes",
          "response_expectation", "coverage"
        ],
        "properties": {
          "alert_type": {
            "enum": [
              "FAILED_INGESTION", "INVALID_BOOK", "REPLAY_FAILURE", "RISK_BREACH",
              "PIPELINE_THRESHOLD", "EXECUTION_THRESHOLD"
            ]
          },
          "owner": {"type": "string", "minLength": 1},
          "severity": {"enum": ["WARNING", "HIGH", "CRITICAL"]},
          "response_target_minutes": {"type": "integer", "minimum": 1},
          "response_expectation": {"type": "string", "minLength": 1},
          "coverage": {"const": "RESEARCH_HOURS"}
        }
      }
    }
  }
}
