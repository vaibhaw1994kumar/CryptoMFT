{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/credential-metadata-1.0.0.json",
  "title": "Non-secret credential metadata registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secret_backend", "credentials"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "secret_backend": {"type": "string", "minLength": 1},
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_id", "venue", "environment", "permissions",
          "secret_reference", "version", "state", "created_ts_ns", "updated_ts_ns"
        ],
        "properties": {
          "credential_id": {"type": "string", "minLength": 1},
          "venue": {"type": "string", "minLength": 1},
          "environment": {"enum": ["PAPER", "TESTNET"]},
          "permissions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["READ_MARKET", "READ_ACCOUNT", "TRADE", "CANCEL"]}
          },
          "secret_reference": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1},
          "state": {"enum": ["ACTIVE", "REVOKED"]},
          "created_ts_ns": {"type": "integer", "minimum": 0},
          "updated_ts_ns": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
