{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/rate-limit-status-1.0.0.json",
  "title": "OMS/EMS rate-limit status snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pending_requests", "venues"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pending_requests": {"type": "integer", "minimum": 0},
    "venues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy", "capacity", "used", "headroom", "window_start_ts_ns",
          "next_window_ts_ns", "throttle_delay_ns", "queue_depth", "queued",
          "delayed", "next_release_ts_ns"
        ],
        "properties": {
          "policy": {"enum": ["REJECT", "QUEUE", "DELAY"]},
          "capacity": {"type": "integer", "minimum": 0},
          "used": {"type": "integer", "minimum": 0},
          "headroom": {"type": "integer", "minimum": 0},
          "window_start_ts_ns": {"type": "integer", "minimum": 0},
          "next_window_ts_ns": {"type": "integer", "minimum": 0},
          "throttle_delay_ns": {"type": "integer", "minimum": 0},
          "queue_depth": {"type": "integer", "minimum": 0},
          "queued": {"type": "integer", "minimum": 0},
          "delayed": {"type": "integer", "minimum": 0},
          "next_release_ts_ns": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
