{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/pretrade-validation-1.0.0.json",
  "title": "OMS/RMS pre-trade validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_id", "ts_ns", "opportunity_id", "strategy_id", "decision", "checks", "failure_codes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "validation_id": {"type": "string", "format": "uuid"},
    "ts_ns": {"type": "integer", "minimum": 0},
    "opportunity_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVED", "REJECTED"]},
    "failure_codes": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "scope", "passed", "venue", "instrument_id", "observed", "limit", "detail"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "scope": {"enum": ["PLATFORM", "STRATEGY", "VENUE", "ACCOUNT", "INSTRUMENT", "MARKET_DATA", "ORDER"]},
          "passed": {"type": "boolean"},
          "venue": {"type": "string"},
          "instrument_id": {"type": "string"},
          "observed": {"type": "string"},
          "limit": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
