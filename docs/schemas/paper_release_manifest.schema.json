{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/paper-release-manifest-1.0.0.json",
  "title": "Immutable paper release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "created_ts_ns", "created_ts_utc",
    "strategy_id", "build", "environment", "artifacts", "identity_sha256",
    "approval_required", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "format": "uuid"},
    "created_ts_ns": {"type": "integer", "minimum": 0},
    "created_ts_utc": {"type": "string", "format": "date-time"},
    "strategy_id": {"type": "string", "minLength": 1},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"type": "string", "minLength": 1}}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "python", "implementation", "platform", "executable"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind", "name", "version", "source_path", "snapshot_path",
          "sha256", "size_bytes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "STRATEGY_CODE", "FEATURE_DEFINITION", "MODEL", "PARAMETERS",
              "DATA_MANIFEST", "SIMULATOR_CONFIG"
            ]
          },
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "snapshot_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_required": {"const": true},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
