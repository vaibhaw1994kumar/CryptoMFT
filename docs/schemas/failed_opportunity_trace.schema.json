{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertowninsights.org/schemas/failed-opportunity-trace-1.0.0.json",
  "title": "Failed opportunity structured-log trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "opportunity_id", "parent_plan_id",
    "terminal_outcome", "record_count", "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "opportunity_id": {"type": "string", "minLength": 1},
    "parent_plan_id": {"type": "string", "minLength": 1},
    "terminal_outcome": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "structured_log.schema.json"}
    }
  }
}
