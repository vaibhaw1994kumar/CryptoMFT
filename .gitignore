# Virtual environments
.venv

# POC runtime data. data/ is ignored except the committed crypto_stat_arb
# samples, evidence bundles and contract-master sample the stat_arb tests read.
data/*
!data/samples/
!data/evidence/
!data/contract_master/
reports/
*.log
.tardis-cache/

# Word copies generated from the Markdown sources by scripts/build_client_doc.py.
# Markdown is the source of truth; a tracked .docx silently goes stale.
*.docx

# Superseded local draft
PCOC.MD

# Opportunity ledger written by demos and local runs
*.db
*.db-wal
*.db-shm

# crypto_stat_arb run outputs

# Compiled mm_matching_engine (built per Python/arch, see docs/execution_realism.md).
src/crypto_stat_arb/sim_engine/*.so
src/crypto_stat_arb/sim_engine/*.pyd

# crypto_MFT_arb_platform/ had its own nested .git; its non-source files
# (docs, configs, Dockerfile, .github/, _backups/) are not tracked by this outer repo.
# Source, tests and scripts are visible so new test files are not silently dropped
# (before, a new tests/ file needed `git add -f`).
crypto_MFT_arb_platform/*
!crypto_MFT_arb_platform/src/
!crypto_MFT_arb_platform/tests/
!crypto_MFT_arb_platform/scripts/

# macOS metadata
.DS_Store
**/.DS_Store

# D7d (owner 9 Nov): the recordings and logs of live runs stay local (large, public feeds); account order data and anything derived per order stays local too
out/integration/paper_live/run1/
out/integration/paper_live/check1/
out/integration/paper_live/shakedown/
out/integration/paper_live/shakedown2/
out/integration/paper_live/*.log
out/integration/paper_live/*.out
out/integration/fill_model_real/__pycache__/
out/integration/fill_model_real/retrain.log
out/integration/fill_model_real/out/superseded_first_run/

